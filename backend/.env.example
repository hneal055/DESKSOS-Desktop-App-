PORT=5000

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Comma-separated list of allowed CORS origins (defaults include Tauri dev + prod origins)
# CORS_ORIGINS=http://localhost:1420,http://tauri.localhost

# Override SQLite database path (defaults to ./data/desksos.db)
# DATABASE_PATH=/path/to/desksos.db

# Set to "production" to use combined Morgan log format
# NODE_ENV=development