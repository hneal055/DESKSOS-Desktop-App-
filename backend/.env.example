# Development settings. In production, ecosystem.config.js (env_production)
# sets PORT 5443, NODE_ENV, TLS paths, DATABASE_PATH and the Enterprise URL,
# and backend/.env.production (secrets only, never committed) is loaded first
# and overrides this file. See docs/OPERATIONS.md section 3.4.

PORT=5000

# Required, at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Comma-separated list of allowed CORS origins (defaults include Tauri dev + prod origins)
# CORS_ORIGINS=http://localhost:1420,http://tauri.localhost

# Override SQLite database path (defaults to ./data/desksos.db; production uses
# ./data/desksos-prod.db via ecosystem.config.js)
# DATABASE_PATH=/path/to/desksos.db

# "production" also requires TLS and seeds random (not password123) passwords
# into a new database. Set by ecosystem.config.js for production; leave unset here.
# NODE_ENV=development


# ── Backup ───────────────────────────────────────────────────────────────────
# npm run backup backs up the dev database; production uses scripts/backup-prod.ps1
# (scheduled by register-tasks.ps1). BACKUP_KEEP is a number of backups, not days.
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14
# ── HTTPS / TLS ──────────────────────────────────────────────────────────────
# Set both to enable HTTPS; leave unset for plain HTTP in development.
# Production sets them in ecosystem.config.js (./certs/server.crt and .key),
# because users' PCs reach the server over the office LAN. Create the
# certificate with mkcert so the DeskSOS CA can be trusted on those PCs:
#   winget install FiloSottile.mkcert
#   pwsh scripts/gen-cert.ps1 -Names localhost,127.0.0.1,FORD-DC01,192.168.12.196
#
# TLS_CERT_PATH=./certs/server.crt
# TLS_KEY_PATH=./certs/server.key

# ── DeskSOS Enterprise bridge (optional) ─────────────────────────────────────
# Forward newly created tickets to the Enterprise incident dashboard. Off unless
# both URL and key are set. See docs/OPERATIONS.md section 3.8.
# ENTERPRISE_INGEST_URL=http://localhost:5100/api/ingest/incidents
# ENTERPRISE_INGEST_KEY=<same value as INGEST_API_KEY on the Enterprise server>
# ENTERPRISE_SOURCE=desksos-desktop
#
# Production: the URL and source come from ecosystem.config.js; put the key in
# backend/.env.production (rotate-ingest-key.ps1 -Production does this). Two
# optional shell variables, read when PM2 starts production:
#   DESKSOS_ENTERPRISE_URL  overrides the Enterprise ingest URL
#   DESKSOS_CA_CERT         CA file for NODE_EXTRA_CA_CERTS (default: mkcert's rootCA.pem)

# ── Error tracking (optional) ────────────────────────────────────────────────
# Set to a Sentry project DSN (sentry.io → Project Settings → Client Keys) to
# get emailed about unhandled server errors. Leave unset to disable.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
