PORT=5000

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Comma-separated list of allowed CORS origins (defaults include Tauri dev + prod origins)
# CORS_ORIGINS=http://localhost:1420,http://tauri.localhost

# Override SQLite database path (defaults to ./data/desksos.db)
# DATABASE_PATH=/path/to/desksos.db

# Set to "production" to use combined Morgan log format
# NODE_ENV=development


# ── Backup ───────────────────────────────────────────────────────────────────
# Run: npm run backup   (or schedule via cron / Windows Task Scheduler)
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14
# ── HTTPS / TLS ──────────────────────────────────────────────────────────────
# Set both to enable HTTPS.  Leave unset to run over plain HTTP (dev only).
#
# DeskSOS is a Tauri desktop app — the backend is localhost-only and never
# exposed to the internet, so a locally-trusted cert (mkcert) is the right
# choice.  Let's Encrypt requires a public domain and does NOT apply here.
#
# Recommended — mkcert (Tauri WebView trusts it automatically):
#   winget install FiloSottile.mkcert
#   cd backend
#   pwsh scripts/gen-cert.ps1          # installs local CA + generates cert
#
# Fallback — self-signed (shows a warning in the WebView):
#   pwsh scripts/gen-cert.ps1          # script falls back if mkcert missing
#
# TLS_CERT_PATH=./certs/server.crt
# TLS_KEY_PATH=./certs/server.key
