# DeskSOS Desktop App — environment variables
# Copy to .env and fill in values before running

# Backend API URL (no trailing slash)
# Use http:// for plain HTTP (development only)
# Use https:// when TLS_CERT_PATH / TLS_KEY_PATH are configured on the backend
VITE_API_URL=http://localhost:5000
# VITE_API_URL=https://localhost:5000
